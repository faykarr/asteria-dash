<!-- Notification Dropdown Component -->
{{!-- Gunakan di navbar dengan: {{> partials/components/notification-dropdown.hbs}} --}}
<div
  x-data="notificationDropdown()"
  class="relative"
  x-on:click.outside="isOpen = false"
>
  <!-- Trigger Button -->
  <button
    class="btn btn-ghost btn-circle relative"
    x-on:click="toggle()"
    :class="isOpen ? 'bg-base-300' : ''"
    aria-label="Notifikasi"
  >
    <div class="indicator">
      <i class="iconoir-bell text-xl"></i>
      <!-- Badge jumlah unread -->
      <span
        x-show="unreadCount > 0"
        x-text="unreadCount > 9 ? '9+' : unreadCount"
        class="badge badge-xs badge-primary indicator-item font-bold text-[10px] min-w-[16px] h-4 px-1"
      ></span>
    </div>
  </button>

  <!-- Dropdown Panel -->
  <div
    x-show="isOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-2 scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-2 scale-95"
    class="absolute right-0 mt-2 w-80 bg-base-100 rounded-2xl shadow-2xl border border-base-300 overflow-hidden z-50"
    style="display:none;"
  >
    <!-- Header -->
    <div class="flex items-center justify-between px-4 py-3 border-b border-base-300 bg-base-200/60">
      <div class="flex items-center gap-2">
        <i class="iconoir-bell text-base text-primary"></i>
        <h3 class="font-semibold text-sm">Notifications</h3>
        <span
          x-show="unreadCount > 0"
          class="badge badge-primary badge-sm font-bold"
          x-text="unreadCount"
        ></span>
      </div>
      <button
        x-show="unreadCount > 0"
        x-on:click="markAllRead()"
        class="btn btn-ghost btn-xs text-primary gap-1 hover:bg-primary/10"
      >
        <i class="iconoir-check-circle text-xs"></i>
        Mark all as read
      </button>
    </div>

    <!-- Notification List -->
    <div class="max-h-80 overflow-y-auto overscroll-contain divide-y divide-base-300">
      <template x-for="(notif, idx) in notifications" :key="notif.id">
        <div
          class="flex items-start gap-3 px-4 py-3 transition-colors cursor-pointer hover:bg-base-200/60 group"
          :class="!notif.read ? 'bg-primary/5' : ''"
          x-on:click="markRead(notif.id)"
        >
          <!-- Icon / Avatar -->
          <div
            class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 mt-0.5"
            :class="notif.iconBg"
          >
            <i :class="notif.icon + ' text-base ' + notif.iconColor"></i>
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-1">
              <p class="text-sm font-semibold leading-snug" x-text="notif.title"></p>
              <!-- Unread dot -->
              <span
                x-show="!notif.read"
                class="w-2 h-2 rounded-full bg-primary shrink-0 mt-1 ring-2 ring-primary/20"
              ></span>
            </div>
            <p class="text-xs text-base-content/60 mt-0.5 leading-snug line-clamp-2" x-text="notif.body"></p>
            <p class="text-xs text-base-content/40 mt-1 flex items-center gap-1">
              <i class="iconoir-clock text-xs"></i>
              <span x-text="notif.time"></span>
            </p>
          </div>
        </div>
      </template>

      <!-- Empty State -->
      <div x-show="notifications.length === 0" class="py-10 text-center">
        <i class="iconoir-bell-off text-4xl text-base-content/25 mb-2 block"></i>
        <p class="text-sm text-base-content/50">No notifications</p>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-4 py-2.5 border-t border-base-300 bg-base-200/40">
      <a
        href="/"
        class="btn btn-ghost btn-sm w-full text-primary hover:bg-primary/10 gap-2"
        x-on:click="isOpen = false"
      >
        <i class="iconoir-arrow-right text-sm"></i>
        See all notifications
      </a>
    </div>
  </div>
</div>

<script>
  function notificationDropdown() {
    return {
      isOpen: false,
      notifications: [
        {
          id: 1,
          title: 'Data berhasil disimpan',
          body: 'Perubahan pada tabel data telah tersimpan dengan sukses.',
          icon: 'iconoir-check-circle',
          iconBg: 'bg-success/15',
          iconColor: 'text-success',
          time: '2 menit lalu',
          read: false,
        },
        {
          id: 2,
          title: 'Pengguna baru terdaftar',
          body: 'Ahmad Fauzi telah mendaftar dan menunggu verifikasi akun.',
          icon: 'iconoir-user-plus',
          iconBg: 'bg-info/15',
          iconColor: 'text-info',
          time: '15 menit lalu',
          read: false,
        },
        {
          id: 3,
          title: 'Pembaruan sistem tersedia',
          body: 'Versi 2.1.0 telah tersedia. Klik untuk melihat perubahan.',
          icon: 'iconoir-refresh-circle',
          iconBg: 'bg-warning/15',
          iconColor: 'text-warning',
          time: '1 jam lalu',
          read: false,
        },
        {
          id: 4,
          title: 'Laporan bulanan siap',
          body: 'Laporan bulan Maret 2026 telah selesai diproses dan dapat diunduh.',
          icon: 'iconoir-page',
          iconBg: 'bg-primary/15',
          iconColor: 'text-primary',
          time: '3 jam lalu',
          read: true,
        },
      ],
      get unreadCount() {
        return this.notifications.filter(n => !n.read).length;
      },
      toggle() {
        this.isOpen = !this.isOpen;
      },
      markRead(id) {
        const notif = this.notifications.find(n => n.id === id);
        if (notif) notif.read = true;
      },
      markAllRead() {
        this.notifications.forEach(n => n.read = true);
      },
    };
  }
</script>
