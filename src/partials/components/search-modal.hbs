<!-- Search Modal Component -->
<!-- Dipanggil via: window.dispatchEvent(new CustomEvent('open-search')) -->
<div x-data="searchModal()" x-on:open-search.window="open()" x-on:keydown.escape.window="close()" class="relative z-50">
  <!-- Backdrop -->
  <div x-show="isOpen" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100" x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm" x-on:click="close()" style="display:none;"></div>

  <!-- Modal Panel -->
  <div x-show="isOpen" x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 translate-y-[-16px] scale-95"
    x-transition:enter-end="opacity-100 translate-y-0 scale-100" x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0 scale-100"
    x-transition:leave-end="opacity-0 translate-y-[-16px] scale-95"
    class="fixed inset-x-0 top-[10vh] mx-auto w-full max-w-xl px-4" style="display:none;">
    <div class="bg-base-100 rounded-2xl shadow-2xl border border-base-300 overflow-hidden">

      <!-- Search Input -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-base-300">
        <i class="iconoir-search text-xl text-base-content/50 shrink-0"></i>
        <input x-ref="searchInput" x-model="query" x-on:input="onQuery()"
          x-on:keydown.down.prevent="selectNext()"
          x-on:keydown.up.prevent="selectPrevious()"
          x-on:keydown.enter.prevent="navigate()"
          type="text"
          placeholder="Search pages, menus, or actions..."
          class="input input-ghost flex-1 px-0 py-0 focus:outline-none text-base placeholder:text-base-content/40 bg-transparent border-none shadow-none focus:border-none focus:shadow-none h-auto"
          autocomplete="off" />
        <!-- Shortcut badge -->
        <kbd class="kbd kbd-sm text-base-content/40 hidden sm:flex items-center gap-1">
          <span class="text-xs">⌘</span>
          <span class="text-xs">K</span>
        </kbd>
      </div>

      <!-- Results / Default Content -->
      <div class="max-h-[60vh] overflow-y-auto overscroll-contain p-2">

        <!-- Empty state saat mengetik tapi tidak ada hasil -->
        <div x-show="query.length > 0 && results.length === 0" class="py-10 text-center">
          <i class="iconoir-search-engine text-4xl text-base-content/30 mb-2 block"></i>
          <p class="text-sm text-base-content/50">No results for "<span x-text="query" class="font-medium"></span>"</p>
        </div>

        <!-- Search Results -->
        <div x-show="query.length > 0 && results.length > 0">
          <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wider px-2 py-1 mb-1">Results</p>
          <template x-for="(item, idx) in results" :key="idx">
            <a :href="item.url"
              class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors group"
              :class="{ 'bg-base-200': activeIndex === idx }"
              x-on:click="saveToRecent(item); close()"
              x-on:mouseenter="activeIndex = idx">
              <span
                class="w-8 h-8 flex items-center justify-center rounded-lg bg-base-200 group-hover:bg-base-300 transition-colors shrink-0">
                <i :class="item.icon + ' text-base text-primary'"></i>
              </span>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium truncate" x-text="item.title"></p>
                <p class="text-xs text-base-content/50 truncate" x-text="item.desc"></p>
              </div>
              <i
                class="iconoir-arrow-up-right text-sm text-base-content/30 group-hover:text-base-content/60 transition-colors"></i>
            </a>
          </template>
        </div>

        <!-- Default: Recent Pages -->
        <div x-show="query.length === 0">
          <template x-if="recentPages.length > 0">
            <div>
              <div class="flex items-center justify-between px-2 py-1 mb-1">
                <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wider">Recent Pages</p>
                <button x-on:click="clearHistory()" class="text-[10px] font-medium text-primary hover:underline transition-all">Clear History</button>
              </div>
              <template x-for="(page, idx) in recentPages" :key="idx">
                <a :href="page.url"
                  class="flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors group"
                  :class="{ 'bg-base-200': activeIndex === idx }"
                  x-on:click="saveToRecent(page); close()"
                  x-on:mouseenter="activeIndex = idx">
                  <span
                    class="w-8 h-8 flex items-center justify-center rounded-lg bg-base-200 group-hover:bg-base-300 transition-colors shrink-0">
                    <i :class="page.icon + ' text-base text-primary'"></i>
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium truncate" x-text="page.title"></p>
                    <p class="text-xs text-base-content/50 truncate" x-text="page.desc"></p>
                  </div>
                  <i class="iconoir-clock text-sm text-base-content/25"></i>
                </a>
              </template>
            </div>
          </template>

          <!-- Empty state semalam (No Recent Pages) -->
          <template x-if="recentPages.length === 0">
            <div class="py-12 text-center">
              <div class="w-16 h-16 bg-base-200 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="iconoir-bubble-search text-2xl text-base-content/30"></i>
              </div>
              <p class="text-sm font-medium text-base-content/60">No recent pages</p>
              <p class="text-xs text-base-content/40 mt-1">Start searching to see your history here.</p>
            </div>
          </template>
        </div>
      </div>

      <!-- Footer Hints -->
      <div class="flex items-center gap-4 px-4 py-2.5 border-t border-base-300 bg-base-200/50">
        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5 text-xs text-base-content/40">
            <kbd class="kbd kbd-sm text-[10px] h-5 min-h-0">↑↓</kbd>
            Navigate
          </span>
          <span class="flex items-center gap-1.5 text-xs text-base-content/40">
            <kbd class="kbd kbd-sm text-[10px] h-5 min-h-0 whitespace-nowrap">Enter</kbd>
            Select
          </span>
        </div>
        <span class="ml-auto flex items-center gap-1 text-xs text-base-content/30 italic">
          <kbd class="kbd kbd-sm text-[10px] h-5 min-h-0">⌘ + K</kbd> to focus
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  function searchModal() {
    // Menyiapkan data pencarian dari sidebar json
    const allPages = [];
    {{#each sidebar}}
    {{#each items}}
    {{#if submenu}}
    {{#each submenu}}
    allPages.push({
      title: '{{label}}',
      desc: '{{../../title}} > {{../label}}',
      icon: '{{icon}}',
      url: '{{url}}'
    });
    {{/each}}
    {{else}}
    allPages.push({
      title: '{{label}}',
      desc: '{{../title}}',
      icon: '{{icon}}',
      url: '{{url}}'
    });
    {{/if}}
    {{/each}}
    {{/each}}

    return {
      isOpen: false,
      query: '',
      results: [],
      activeIndex: -1,
      recentPages: [],
      init() {
        this.loadRecentPages();
      },
      loadRecentPages() {
        const saved = localStorage.getItem('asteria_recent_pages');
        if (saved) {
          this.recentPages = JSON.parse(saved);
        }
      },
      saveToRecent(item) {
        // Hapus duplikat berdasarkan URL
        let history = this.recentPages.filter(p => p.url !== item.url);
        // Tambahkan ke awal
        history.unshift({
          title: item.title,
          desc: item.desc,
          icon: item.icon,
          url: item.url
        });
        // Batasi maksimal 5
        this.recentPages = history.slice(0, 5);
        localStorage.setItem('asteria_recent_pages', JSON.stringify(this.recentPages));
      },
      clearHistory() {
        this.recentPages = [];
        localStorage.removeItem('asteria_recent_pages');
      },
      open() {
        this.isOpen = true;
        this.query = '';
        this.results = [];
        this.activeIndex = -1;
        this.$nextTick(() => { this.$refs.searchInput?.focus(); });
      },
      close() {
        this.isOpen = false;
        this.query = '';
        this.results = [];
        this.activeIndex = -1;
      },
      onQuery() {
        const q = this.query.toLowerCase().trim();
        this.activeIndex = -1;
        if (!q) { this.results = []; return; }

        // Cari di semua halaman yang diambil dari sidebar
        this.results = allPages.filter(i =>
          i.title.toLowerCase().includes(q) ||
          i.desc.toLowerCase().includes(q)
        );
      },
      get currentItems() {
        return this.query.length > 0 ? this.results : this.recentPages;
      },
      selectNext() {
        if (this.currentItems.length === 0) return;
        this.activeIndex = (this.activeIndex + 1) % this.currentItems.length;
      },
      selectPrevious() {
        if (this.currentItems.length === 0) return;
        this.activeIndex = (this.activeIndex - 1 + this.currentItems.length) % this.currentItems.length;
      },
      navigate() {
        if (this.activeIndex >= 0 && this.activeIndex < this.currentItems.length) {
          const item = this.currentItems[this.activeIndex];
          this.saveToRecent(item);
          window.location.href = item.url;
          this.close();
        }
      }
    };
  }
</script>