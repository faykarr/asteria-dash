<aside class="bg-base-200 h-screen w-72 flex flex-col border-r border-base-300">
  <!-- Brand Logo -->
  <div class="flex items-center gap-3 px-4 py-5 border-b border-base-300">
    <div class="bg-primary text-primary-content rounded-box p-2 flex items-center justify-center">
      {{!-- Icon Brand --}}
      <i class="iconoir-percentage-square text-2xl"></i>

      {{!-- Image brand --}}
      {{!-- <img src="{{brandLogo}}" alt="Brand Logo" class="w-8 h-8 rounded-xl select-none pointer-events-none" /> --}}
    </div>
    <div>
      <h1 class="text-lg font-bold text-base-content">{{brandName}}</h1>
      <p class="text-xs text-base-content/60">Admin Dashboards</p>
    </div>
  </div>

  <!-- Navigation Menu -->
  <ul id="sidebar-menu"
    class="menu menu-md flex-1 flex-col flex-nowrap px-3 py-4 w-full gap-1 relative overflow-hidden">

    {{#each sidebar}}
    <li class="menu-title {{#if @first}}{{else}}mt-4{{/if}}">{{title}}</li>
    {{#each items}}
    <li>
      {{#if submenu}}
      <details>
        <summary class="py-2">
          <i class="{{icon}} text-lg"></i>
          {{label}}
        </summary>
        <ul class="flex flex-col gap-1.5 mt-2">
          {{#each submenu}}
          <li>
            <a href="{{url}}" class="py-2">
              <span class="flex justify-start items-center gap-2">
                <i class="{{icon}} text-lg"></i>
                {{label}}
              </span>
            </a>
          </li>
          {{/each}}
        </ul>
      </details>
      {{else}}
      <a href="{{url}}" class="py-2 {{#if active}}menu-active{{/if}}">
        <i class="{{icon}} text-lg"></i>
        {{label}}
      </a>
      {{/if}}
    </li>
    {{/each}}
    {{/each}}
  </ul>

  <!-- User Profile & Logout di bottom -->
  <div class="border-t border-base-300 p-3 flex flex-col gap-1">
    <!-- User Info -->
    <div class="flex items-center gap-3 px-2 py-2">
      <div class="avatar">
        <div class="w-10 rounded-full ring-2 ring-primary/30 pointer-events-none select-none">
          <img alt="User" src="https://picsum.photos/80/80?random=1" />
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold truncate">Admin</p>
        <p class="text-xs text-base-content/50 truncate">admin@asteria.dev</p>
        <span class="badge badge-primary badge-xs mt-1">Administrator</span>
      </div>
    </div>

    <div class="divider my-0 px-2 h-px"></div>

    <!-- Logout -->
    <a href="#"
      class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-error/10 transition-colors group text-left mt-1">
      <span
        class="w-7 h-7 flex items-center justify-center rounded-lg bg-error/10 group-hover:bg-error/20 transition-colors">
        <i class="iconoir-log-out text-sm text-error"></i>
      </span>
      <span class="text-sm text-error font-medium">Sign Out</span>
    </a>
  </div>
</aside>