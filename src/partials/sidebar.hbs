        <summary class="py-2 menu-active">
          <i class="iconoir-dashboard text-lg"></i>
          Dashboards
        </summary>
        <ul class="flex flex-col gap-1.5 mt-2">
          <li>
            <a class="py-2 menu-active">
              <span class="flex justify-start items-center gap-2">
                <i class="iconoir-dashboard text-lg"></i>
                E-Commerce
              </span>
            </a>
          </li>
          <li>
            <a class="py-2">
              <span class="flex justify-start items-center gap-2">
                <i class="iconoir-dashboard text-lg"></i>
                Finance
              </span>
            </a>
          </li>
          <li>
            <a class="py-2">
              <span class="flex justify-start items-center gap-2">
                <i class="iconoir-dashboard text-lg"></i>
                Project
              </span>
            </a>
          </li>
        </ul>
      </details>
    </li>
    <li>
      <a class="py-2">
        <i class="iconoir-graph-up text-lg"></i>
        Analytics
      </a>
    </li>

    <li class="menu-title mt-4">Management</li>
    <li>
      <details>
        <summary class="py-2">
          <i class="iconoir-group text-lg"></i>
          Users
        </summary>
        <ul>
          <li><a class="py-2">All Users</a></li>
          <li><a class="py-2">Add User</a></li>
          <li><a class="py-2">Roles</a></li>
        </ul>
      </details>
    </li>

    <li class="menu-title mt-4">Layouts</li>
    <li>
      <details>
        <summary class="py-2">
          <i class="iconoir-layout-left text-lg"></i>
          Layouts
        </summary>
        <ul class="flex flex-col gap-1.5 mt-2">
          <li>
            <a class="py-2">
              <span class="flex justify-start items-center gap-2">
                <i class="iconoir-dashboard text-lg"></i>
                Blank Layout
              </span>
            </a>
          </li>
        </ul>
      </details>
    </li>
    <li>
      <a class="py-2">
        <i class="iconoir-settings text-lg"></i>
        Settings
      </a>
    </li>
  </ul>

  <!-- User Profile & Logout di bottom -->
  <div class="border-t border-base-300 p-3 flex flex-col gap-1">
    <!-- User Info -->
    <div class="flex items-center gap-3 px-2 py-2">
      <div class="avatar">
        <div class="w-10 rounded-full ring-2 ring-primary/30">
          <img alt="User" src="https://picsum.photos/80/80?random=1" />
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-sm font-semibold truncate">Admin</p>
        <p class="text-xs text-base-content/50 truncate">admin@asteria.dev</p>
        <span class="badge badge-primary badge-xs mt-1">Administrator</span>
      </div>
    </div>

    <div class="divider my-0 px-2 h-px"></div>

    <!-- Logout -->
    <a href="#"
      class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-error/10 transition-colors group text-left mt-1">
      <span
        class="w-7 h-7 flex items-center justify-center rounded-lg bg-error/10 group-hover:bg-error/20 transition-colors">
        <i class="iconoir-log-out text-sm text-error"></i>
      </span>
      <span class="text-sm text-error font-medium">Sign Out</span>
    </a>
