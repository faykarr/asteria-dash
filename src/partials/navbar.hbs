<div class="navbar bg-base-200 border-b border-base-300 sticky top-0 z-30">
  <div class="navbar-start">
    <!-- Hamburger toggle untuk mobile -->
    <label for="sidebar-drawer" class="btn btn-ghost btn-square lg:hidden">
      <i class="iconoir-menu text-xl"></i>
    </label>
    <!-- Breadcrumbs -->
    <div class="breadcrumbs text-sm ml-2 hidden sm:block">
      <ul>
        <li><a>Home</a></li>
        <li>{{#if pageTitle}}{{pageTitle}}{{else}}Dashboard{{/if}}</li>
      </ul>
    </div>
  </div>
  <div class="navbar-end gap-2">
    <!-- Search -->
    <button class="btn btn-ghost btn-circle">
      <i class="iconoir-search text-xl"></i>
    </button>
    <!-- Theme Toggle -->
    <label class="btn btn-ghost btn-circle swap swap-rotate">
      <input type="checkbox" class="theme-controller" value="asteria-dark" />
      <i class="iconoir-sun-light text-xl swap-off" title="Switch to Light Mode"></i>
      <i class="iconoir-half-moon text-xl swap-on" title="Switch to Dark Mode"></i>
    </label>
    <!-- Notifications -->
    <button class="btn btn-ghost btn-circle">
      <div class="indicator">
        <i class="iconoir-bell text-xl"></i>
        <span class="badge badge-xs badge-primary indicator-item"></span>
      </div>
    </button>
    <!-- User avatar dropdown -->
    <details class="dropdown dropdown-end">
      <summary class="btn btn-ghost btn-circle avatar">
        <div class="w-8 rounded-full">
          <img alt="User" src="https://picsum.photos/80/80?random=1" />
        </div>
      </summary>
      <ul class="dropdown-content menu bg-base-200 rounded-box w-52 p-2 shadow-lg mt-2 z-50">
        <li><a>Profile</a></li>
        <li><a>Settings</a></li>
        <li><a>Logout</a></li>
      </ul>
    </details>
  </div>
</div>
