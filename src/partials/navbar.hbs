<div class="navbar bg-base-200 border-b border-base-300 sticky top-0 z-30">
  <div class="navbar-start">
    <!-- Hamburger toggle untuk mobile -->
    <label for="sidebar-drawer" class="btn btn-ghost btn-square lg:hidden">
      <i class="iconoir-menu text-xl"></i>
    </label>
    <!-- Breadcrumbs -->
    <div class="breadcrumbs text-sm ml-2 hidden sm:block">
      <ul>
        <li><a href="#">Home</a></li>
        {{#if pageTitle}}<li>{{pageTitle}}</li>{{else}}{{/if}}
      </ul>
    </div>
  </div>
  <div class="navbar-end gap-1">
    <button
      class="btn btn-ghost btn-circle sm:w-56 sm:btn-outline sm:border-base-300 sm:bg-base-100 sm:hover:bg-base-200 sm:justify-start sm:font-normal sm:text-base-content/50 sm:px-3"
      onclick="window.dispatchEvent(new CustomEvent('open-search'))" aria-label="Cari">
      <i class="iconoir-search text-xl sm:text-lg"></i>
      <span class="hidden sm:inline">Search...</span>
      <div class="hidden sm:flex items-center gap-0.5 ml-auto">
        <kbd class="kbd kbd-sm bg-base-200 border-none text-[10px] min-h-0 h-5 px-1.5">Ctrl</kbd>
        <span class="text-[10px]">+</span>
        <kbd class="kbd kbd-sm bg-base-200 border-none text-[10px] min-h-0 h-5 px-1.5">K</kbd>
      </div>
    </button>

    <!-- Theme Toggle -->
    <label class="btn btn-ghost btn-circle swap swap-rotate" title="Toggle tema">
      <input type="checkbox" class="theme-controller" value="asteria-dark" />
      <i class="iconoir-sun-light text-xl swap-off" title="Switch to Light Mode"></i>
      <i class="iconoir-half-moon text-xl swap-on" title="Switch to Dark Mode"></i>
    </label>

    <!-- Notifications -->
    {{> partials/components/notification-dropdown.hbs}}

    <!-- User Profile Dropdown -->
    <div x-data="{ open: false }" class="relative" x-on:click.outside="open = false">
      <!-- Trigger -->
      <button class="btn btn-ghost btn-circle avatar" x-on:click="open = !open"
        :class="open ? 'ring-2 ring-primary ring-offset-2 ring-offset-base-200' : ''" aria-label="Menu profil">
        <div class="w-8 rounded-full">
          <img alt="User" src="https://picsum.photos/80/80?random=1" />
        </div>
      </button>

      <!-- Dropdown -->
      <div x-show="open" x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 translate-y-2 scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0 scale-100"
        x-transition:leave-end="opacity-0 translate-y-2 scale-95"
        class="absolute right-0 mt-2 w-60 bg-base-100 rounded-2xl shadow-2xl border border-base-300 overflow-hidden z-50"
        style="display:none;">
        <!-- User Info Header -->
        <div class="px-4 py-4 bg-base-200/60 flex items-center gap-3">
          <div class="avatar">
            <div class="w-10 rounded-full ring-2 ring-primary/30">
              <img alt="User" src="https://picsum.photos/80/80?random=1"  />
            </div>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold truncate">Admin</p>
            <p class="text-xs text-base-content/50 truncate">admin@asteria.dev</p>
            <span class="badge badge-primary badge-xs mt-1">Administrator</span>
          </div>
        </div>

        <!-- Menu utama -->
        <div class="p-1.5">
          <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-base-200 transition-colors group"
            x-on:click="open = false">
            <span
              class="w-7 h-7 flex items-center justify-center rounded-lg bg-base-200 group-hover:bg-base-300 transition-colors">
              <i class="iconoir-user text-sm text-base-content/70"></i>
            </span>
            <span class="text-sm">My Profile</span>
          </a>
          <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-base-200 transition-colors group"
            x-on:click="open = false">
            <span
              class="w-7 h-7 flex items-center justify-center rounded-lg bg-base-200 group-hover:bg-base-300 transition-colors">
              <i class="iconoir-settings text-sm text-base-content/70"></i>
            </span>
            <span class="text-sm">Settings</span>
          </a>
          <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-base-200 transition-colors group"
            x-on:click="open = false">
            <span
              class="w-7 h-7 flex items-center justify-center rounded-lg bg-base-200 group-hover:bg-base-300 transition-colors">
              <i class="iconoir-help-circle text-sm text-base-content/70"></i>
            </span>
            <span class="text-sm">Helps</span>
          </a>
        </div>

        <!-- Divider -->
        <div class="divider my-0 px-3 h-px"></div>

        <!-- Logout -->
        <div class="p-1.5">
          <button
            class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-error/10 transition-colors group text-left"
            x-on:click="open = false">
            <span
              class="w-7 h-7 flex items-center justify-center rounded-lg bg-error/10 group-hover:bg-error/20 transition-colors">
              <i class="iconoir-log-out text-sm text-error"></i>
            </span>
            <span class="text-sm text-error font-medium">Sign Out</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>