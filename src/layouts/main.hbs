<!DOCTYPE html>
<html lang="id" data-theme="asteria-light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{{#if pageTitle}}{{pageTitle}} — {{brandName}}{{else}}{{brandName}}{{/if}}</title>
</head>
<body>

  <div class="drawer lg:drawer-open">
    <!-- Toggle checkbox untuk mobile sidebar -->
    <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

    <!-- Drawer Content (Navbar + Main + Footer) -->
    <div class="drawer-content flex flex-col min-h-screen">
      {{> partials/navbar.hbs}}

      <main class="flex-1 p-4 lg:p-6">
        {{> @partial-block }}
      </main>

      {{> partials/footer.hbs}}
    </div>

    <!-- Drawer Sidebar -->
    <div class="drawer-side z-40">
      <label for="sidebar-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
      {{> partials/sidebar.hbs}}
    </div>
  </div>

  <script type="module" src="/src/assets/js/app.js"></script>
</body>
</html>
