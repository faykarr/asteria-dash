{{#> layouts/main.hbs pageTitle="Dashboard" }}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <!-- Stat Card 1 -->
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body p-4 flex flex-row items-center gap-4">
      <div class="p-3 bg-primary/10 text-primary rounded-box">
        <i class="iconoir-user text-2xl"></i>
      </div>
      <div>
        <h3 class="text-base-content/60 text-sm">Total Users</h3>
        <p class="text-2xl font-bold">12,450</p>
      </div>
    </div>
  </div>
  
  <!-- Stat Card 2 -->
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body p-4 flex flex-row items-center gap-4">
      <div class="p-3 bg-secondary/10 text-secondary rounded-box">
        <i class="iconoir-eye text-2xl"></i>
      </div>
      <div>
        <h3 class="text-base-content/60 text-sm">Page Views</h3>
        <p class="text-2xl font-bold">2.4M</p>
      </div>
    </div>
  </div>

  <!-- Stat Card 3 -->
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body p-4 flex flex-row items-center gap-4">
      <div class="p-3 bg-accent/10 text-accent rounded-box">
        <i class="iconoir-cart text-2xl"></i>
      </div>
      <div>
        <h3 class="text-base-content/60 text-sm">New Orders</h3>
        <p class="text-2xl font-bold">842</p>
      </div>
    </div>
  </div>

  <!-- Stat Card 4 -->
  <div class="card bg-base-200 border border-base-300">
    <div class="card-body p-4 flex flex-row items-center gap-4">
      <div class="p-3 bg-success/10 text-success rounded-box">
        <i class="iconoir-wallet text-2xl"></i>
      </div>
      <div>
        <h3 class="text-base-content/60 text-sm">Total Revenue</h3>
        <p class="text-2xl font-bold">$42.5K</p>
      </div>
    </div>
  </div>
</div>

<div class="card bg-base-200 border border-base-300">
  <div class="card-body">
    <h2 class="card-title mb-4">Recent Transactions</h2>
    <div class="overflow-x-auto">
      <table class="table table-zebra w-full datatable">
        <thead>
          <tr>
            <th>ID</th>
            <th>MEMBER</th>
            <th>DATE</th>
            <th>AMOUNT</th>
            <th>STATUS</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>#1001</td>
            <td>John Doe</td>
            <td>Oct 20, 2026</td>
            <td>$124.00</td>
            <td><span class="badge badge-success badge-sm">Completed</span></td>
          </tr>
          <tr>
            <td>#1002</td>
            <td>Jane Smith</td>
            <td>Oct 19, 2026</td>
            <td>$54.00</td>
            <td><span class="badge badge-warning badge-sm">Pending</span></td>
          </tr>
          <tr>
            <td>#1003</td>
            <td>Mike Johnson</td>
            <td>Oct 18, 2026</td>
            <td>$299.00</td>
            <td><span class="badge badge-success badge-sm">Completed</span></td>
          </tr>
          <tr>
            <td>#1004</td>
            <td>Alice Williams</td>
            <td>Oct 17, 2026</td>
            <td>$45.50</td>
            <td><span class="badge badge-error badge-sm">Failed</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

{{/layouts/main.hbs}}
