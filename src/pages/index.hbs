{{#> layouts/main.hbs }}

<!-- Welcome Banner -->
<div class="card bg-base-200 border border-base-300 overflow-hidden relative mb-6">
  <!-- Decorative background -->
  <div class="absolute top-0 right-0 -mt-10 -mr-10 opacity-[0.03] text-base-content">
    <i class="iconoir-percentage-square text-[280px]"></i>
  </div>

  <div class="card-body p-6 md:p-8 flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
    <!-- Avatar -->
    <div class="avatar shadow-xl rounded-full">
      <div class="w-24 h-24 rounded-full ring-4 ring-primary/20 ring-offset-base-200 ring-offset-2">
        <img alt="User" src="https://picsum.photos/80/80?random=1" />
      </div>
    </div>

    <!-- Welcome Text -->
    <div class="text-center sm:text-left flex-1 mt-2 sm:mt-0">
      <h1 class="text-3xl font-bold mb-2">Welcome back, Admin! 👋</h1>
      <p class="text-base-content/70 mb-5 max-w-xl">
        We're glad to see you again. Manage your operations, track your stats, and explore new features easily from your
        command center.
      </p>

      <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
        <div class="px-3 py-1.5 rounded-xl bg-base-100 border border-base-300 text-sm flex items-center gap-2">
          <i class="iconoir-mail text-base-content/60 text-lg"></i> admin@asteria.dev
        </div>
        <div
          class="px-3 py-1.5 rounded-xl bg-primary/10 text-primary border border-primary/20 text-sm font-medium flex items-center gap-1.5">
          <i class="iconoir-badge-check text-lg"></i> Administrator
        </div>
        <script type='text/javascript' src='https://storage.ko-fi.com/cdn/widget/Widget_2.js'></script><script type='text/javascript'>kofiwidget2.init('Support me on Ko-fi', '#72a4f2', 'C0C01W990I');kofiwidget2.draw();</script>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="mt-4 sm:mt-0 flex gap-2">
      <button class="btn btn-outline btn-sm">
        <i class="iconoir-bell"></i> Notifications
      </button>
      <button class="btn btn-primary btn-sm shadow-md shadow-primary/20">
        <i class="iconoir-user"></i> My Profile
      </button>
    </div>
  </div>
</div>

<!-- About Project -->
<div
  class="card lg:card-side bg-base-200 border border-base-300 shadow-sm mb-8 overflow-hidden hover:shadow-md transition-shadow">

  <div class="card-body lg:w-1/2 p-6 md:p-8 z-10 relative order-2 lg:order-1">
    <div class="badge badge-primary badge-outline mb-1 font-medium bg-base-100">Starter Kit UI</div>
    <h2 class="card-title text-2xl md:text-3xl font-bold mb-3">Asteria Dash Admin Template</h2>
    <p class="text-base-content/70 leading-relaxed text-[15px] mb-2">
      <strong class="text-base-content">Asteria Dash</strong> is an open source agnostic framework admin dashboard template meticulously crafted using cutting-edge web technologies
      like <strong class="text-base-content">Vite</strong>, <strong class="text-base-content">Handlebars</strong>,
      <strong class="text-base-content">Alpine.js</strong>, and the utility-first power of <strong
        class="text-base-content">TailwindCSS</strong> with <strong class="text-base-content">DaisyUI</strong>.
    </p>
    <p class="text-base-content/60 leading-relaxed text-sm mb-4">
      It is engineered to be delightfully responsive, lightweight, and blazingly fast, ensuring a seamless modular
      developer experience while accelerating out-of-the-box UI delivery for robust systems.
    </p>
    <div class="flex flex-wrap items-center gap-3 mt-auto pt-2">
      <button class="btn btn-outline">
        <i class="iconoir-book"></i> Docs
      </button>
      <a href="https://github.com/faykarr/asteria-dash" target="_blank" rel="noopener noreferrer"
        class="btn btn-primary shadow-md shadow-primary/20">
        <i class="iconoir-github"></i> Repository
      </a>
      <a href="https://github.com/faykarr/asteria-dash" target="_blank" rel="noopener noreferrer"
        class="btn bg-base-100 border-base-300 hover:border-warning/50 hover:bg-warning/10 gap-2">
        <i class="iconoir-star-solid text-warning"></i> Star us on Github
      </a>
    </div>
  </div>

  <figure class="lg:w-1/2 relative h-64 lg:h-auto overflow-hidden order-1 lg:order-2">
    <div class="carousel w-full h-full">
      <div id="slide1" class="carousel-item relative w-full h-full">
        <img src="https://picsum.photos/1200/800?random=21" class="object-cover w-full h-full" alt="Feature 1" />
        <div class="absolute flex justify-between transform -translate-y-1/2 left-4 right-4 top-1/2">
          <a href="#slide3" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❮</a>
          <a href="#slide2" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❯</a>
        </div>
      </div>
      <div id="slide2" class="carousel-item relative w-full h-full">
        <img src="https://picsum.photos/1200/800?random=22" class="object-cover w-full h-full" alt="Feature 2" />
        <div class="absolute flex justify-between transform -translate-y-1/2 left-4 right-4 top-1/2">
          <a href="#slide1" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❮</a>
          <a href="#slide3" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❯</a>
        </div>
      </div>
      <div id="slide3" class="carousel-item relative w-full h-full">
        <img src="https://picsum.photos/1200/800?random=23" class="object-cover w-full h-full" alt="Feature 3" />
        <div class="absolute flex justify-between transform -translate-y-1/2 left-4 right-4 top-1/2">
          <a href="#slide2" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❮</a>
          <a href="#slide1" class="btn btn-circle btn-sm btn-ghost bg-base-100/50 backdrop-blur-sm border-none">❯</a>
        </div>
      </div>
    </div>
    <div class="absolute inset-0 pointer-events-none"></div>
  </figure>
</div>

<!-- UI Design System Information -->
<div x-data="{ 
  isDark: document.documentElement.getAttribute('data-theme') === 'asteria-dark',
  init() {
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme') {
          this.isDark = document.documentElement.getAttribute('data-theme') === 'asteria-dark';
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true });
  }
}">
  <div class="flex items-center justify-between mb-4 px-1">
    <h2 class="text-xl font-bold">Design System</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Color Palette -->
    <div class="card bg-base-200 border border-base-300 shadow-sm">
      <div class="card-body p-6">
        <h3 class="flex items-center gap-2 font-bold text-lg mb-4">
          <i class="iconoir-color-picker text-primary"></i> Color Palette
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
          <!-- Primary -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-primary shadow-sm" title="Primary Color"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Primary</p>
              <p class="text-sm font-mono" x-text="isDark ? '#B9F14E' : '#99E600'">#99E600</p>
            </div>
          </div>
          <!-- Secondary -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-secondary shadow-sm" title="Secondary Color"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Secondary</p>
              <p class="text-sm font-mono" x-text="isDark ? '#99E600' : '#7ACC00'">#7ACC00</p>
            </div>
          </div>
          <!-- Accent -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-accent shadow-sm" title="Accent Color"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Accent</p>
              <p class="text-sm font-mono" x-text="isDark ? '#01DF72' : '#7ACC00'">#7ACC00</p>
            </div>
          </div>
          <!-- Neutral -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-neutral shadow-sm" title="Neutral Color"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Neutral</p>
              <p class="text-sm font-mono" x-text="isDark ? '#B9F14E' : '#43546A'">#43546A</p>
            </div>
          </div>
          <!-- Base 100 -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-base-100 border border-base-300 shadow-sm" title="Base Background"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Base 100</p>
              <p class="text-sm font-mono" x-text="isDark ? '#0D1529' : '#F7F9FA'">#F7F9FA</p>
            </div>
          </div>
          <!-- Success -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-success shadow-sm" title="Success State"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Success</p>
              <p class="text-sm font-mono" x-text="isDark ? '#7ACC00' : '#7ACC00'">#7ACC00</p>
            </div>
          </div>
          <!-- Info -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-info shadow-sm" title="Info State"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Info</p>
              <p class="text-sm font-mono" x-text="isDark ? '#00B6D9' : '#0082CE'">#0082CE</p>
            </div>
          </div>
          <!-- Warning -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-warning shadow-sm" title="Warning State"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Warning</p>
              <p class="text-sm font-mono" x-text="isDark ? '#EEAF00' : '#EEAF00'">#EEAF00</p>
            </div>
          </div>
          <!-- Error -->
          <div class="flex flex-col gap-2">
            <div class="h-12 w-full rounded-lg bg-error shadow-sm" title="Error State"></div>
            <div>
              <p class="text-xs font-bold uppercase opacity-60">Error</p>
              <p class="text-sm font-mono" x-text="isDark ? '#FE1C55' : '#EA003E'">#EA003E</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Typography -->
    <div class="card bg-base-200 border border-base-300 shadow-sm">
      <div class="card-body p-6">
        <h3 class="flex items-center gap-2 font-bold text-lg mb-4">
          <i class="iconoir-text-size text-secondary"></i> Typography
        </h3>
        <div class="space-y-4">
          <div>
            <p class="text-xs font-bold uppercase opacity-60 mb-1">Font Family</p>
            <code class="text-sm bg-base-300 px-2 py-1 rounded">Inter, ui-sans-serif, system-ui</code>
          </div>
          <div class="pt-2">
            <p class="text-xs font-bold uppercase opacity-60 mb-2">Scale Preview</p>
            <div class="space-y-3">
              <div class="flex items-end gap-3">
                <span class="text-3xl font-bold">Aa</span>
                <span class="text-sm opacity-50">Heading 1 (30px / 1.875rem)</span>
              </div>
              <div class="flex items-end gap-3">
                <span class="text-2xl font-bold">Aa</span>
                <span class="text-sm opacity-50">Heading 2 (24px / 1.5rem)</span>
              </div>
              <div class="flex items-end gap-3">
                <span class="text-xl font-bold">Aa</span>
                <span class="text-sm opacity-50">Heading 3 (20px / 1.25rem)</span>
              </div>
              <div class="flex items-end gap-3">
                <span class="text-base">Aa</span>
                <span class="text-sm opacity-50">Body Text (16px / 1rem)</span>
              </div>
              <div class="flex items-end gap-3">
                <span class="text-sm">Aa</span>
                <span class="text-sm opacity-50">Small Text (14px / 0.875rem)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{/layouts/main.hbs}}